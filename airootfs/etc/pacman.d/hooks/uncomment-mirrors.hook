# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = artix-mirrorlist
Target = archlinux-mirrorlist

[Action]
Description = Uncommenting HTTPS mirrors in mirrorlists...
When = PostTransaction
Depends = sed
Exec = /usr/bin/sed -E -i 's/#(Server = https:)/\1/g' /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist-arch
